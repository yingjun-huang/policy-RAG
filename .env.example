APP_ENV=development
APP_NAME=policy-rag
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
KNOWLEDGE_DIR=knowledge_jd

# Generic OpenAI-compatible LLM (takes precedence over DEEPSEEK_* when LLM_API_KEY is set)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Legacy DeepSeek fallback (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# BGE Dense Embedding (Local)
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=512

# BGE Cross-Encoder Reranker (Local)
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_MAX_LENGTH=512
HF_ENDPOINT=https://hf-mirror.com

# Qdrant Vector Store & Scalar Payload Indexing
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=
QDRANT_PATH=
QDRANT_COLLECTION=policy_chunks

# Retrieval & Self-RAG Hyperparameters
RETRIEVAL_TOP_K_SIMPLE=3
RETRIEVAL_TOP_K_COMPLEX=6
RRF_K=60
RERANK_TOP_N=5
MAX_RETRIEVAL_HOPS=2
